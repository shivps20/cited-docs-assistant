# Copy to .env and adjust. .env is git-ignored; this file is committed.
# Relative paths are resolved from the project root.

# --- Qdrant (deploy/docker-compose.yml maps host 6444 -> container 6333) ---
QDRANT_URL=http://127.0.0.1:6444
QDRANT_COLLECTION=kb_chunks

# --- SQLite ---
KB_DB_PATH=data/kb.db

# --- Source documents and their manifest ---
KB_DOCS_DIR=data/documents
KB_MANIFEST_PATH=config/manifest.csv

# --- Local models (downloaded by scripts/download_models.py) ---
KB_MODELS_DIR=models
EMBED_MODEL_PATH=models/bge-m3
RERANK_MODEL_PATH=models/bge-reranker-v2-m3
DOCLING_ARTIFACTS_PATH=models/docling
# Never fetch from Hugging Face at runtime; models load from the paths above.
# scripts/download_models.py overrides this while downloading.
HF_HUB_OFFLINE=1

# --- Retrieval ---
# Rerank only the first N search candidates (CPU reranking: ~0.5 s per candidate).
KB_RERANK_TOP=20
# Reply "not found" without calling the LLM when the best rerank score is below this.
KB_NOT_FOUND_SCORE=0.1
# When the model finds no answer, ask once more with only the best-matching sources.
KB_REFUSAL_RETRY=true
# Comparisons: read up to 2 more sections per side, chosen from each guide's table of contents.
# Disabled in code for now (did not help with a 7B model); re-enable in kb/core/config.py with a larger model.
# KB_COMPARE_READ=false

# --- Local LLM (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct
# Ollama's default context is small and silently truncates prompts.
LLM_NUM_CTX=8192
LLM_KEEP_ALIVE=10m
# 0 = same answer for the same question and context.
LLM_TEMPERATURE=0
# Maximum answer length in tokens.
LLM_MAX_TOKENS=1500
# auto: OpenAI when configured and every source has external_ok=true, else Ollama.
KB_LLM_PROVIDER=auto

# --- Optional: OpenAI (used only for documents with external_ok=true) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Chat API (kb serve) ---
# Users and their access groups; the browser only names the user.
KB_USERS_PATH=config/users.yaml
# Organisation-specific text rules and the golden question set (both local, git-ignored;
# start from config/domain.example.yaml and eval/golden.example.json).
KB_DOMAIN_PATH=config/domain.yaml
KB_GOLDEN_PATH=eval/golden.json
# Keep 127.0.0.1: users are not authenticated.
KB_API_HOST=127.0.0.1
KB_API_PORT=8000
